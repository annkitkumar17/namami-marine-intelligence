# NAMAMI Platform Environment Configuration

# Service Ports & Hostnames
NODE_PORT=4000
BRAIN_PORT=8000
WEB_PORT=3000
EDGE_URL=http://localhost:4000
BRAIN_URL=http://localhost:8000

# Database (PostgreSQL + PostGIS + TimescaleDB)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=namami
POSTGRES_USER=namami_user
POSTGRES_PASSWORD=namami_password
DATABASE_URL=postgresql+asyncpg://namami_user:namami_password@localhost:5432/namami

# Cache & Storage
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET_COG=namami-cog-granules

# Data Source API Credentials (Sandboxed / Access Pending)
INCOIS_PFZ_API_URL=https://incois.gov.in/portal/pfz/advisory
IMD_DISTRICT_WARNING_URL=https://mausam.imd.gov.in/api/districtwarning
MOSDAC_SST_API_URL=https://api.mosdac.gov.in/products/sst
BHOONIDHI_API_URL=https://bhoonidhi.nrsc.gov.in/api/ocm3

# Environment
NODE_ENV=development
DATA_MODE=FIXTURE # FIXTURE | REAL | FALLBACK
