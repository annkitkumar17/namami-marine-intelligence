# NAMAMI Platform Environment Configuration
# Copy to `.env` for local development. Never commit real secrets.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=info

# Fixture mode is the default. REAL requires approved credentials and flags.
# DATA_MODE: FIXTURE | REAL | FALLBACK
DATA_MODE=FIXTURE
READY_STRICT=false

# ---------------------------------------------------------------------------
# Service ports (host)
# ---------------------------------------------------------------------------
EDGE_PORT=4000
BRAIN_PORT=8000
WEB_PORT=3000
EDGE_URL=http://localhost:4000
BRAIN_URL=http://localhost:8000
BRAIN_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_EDGE_URL=http://localhost:4000
NEXT_PUBLIC_BRAIN_URL=http://localhost:8000
NEXT_PUBLIC_DATA_MODE=FIXTURE

# ---------------------------------------------------------------------------
# PostgreSQL + PostGIS
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=namami
POSTGRES_USER=namami_user
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://namami_user:changeme@localhost:5432/namami

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# MinIO object storage
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme-minio
MINIO_BUCKET_COG=namami-cog-granules
MINIO_USE_SSL=false

# ---------------------------------------------------------------------------
# Official External Provider Configurations (Phase 1 & 2 Specification)
# Never scrape protected government websites. Use official authorized APIs only.
# ---------------------------------------------------------------------------
INCOIS_ENABLED=false
INCOIS_BASE_URL=https://incois.gov.in/api/v1
INCOIS_API_KEY=

IMD_ENABLED=false
IMD_BASE_URL=https://mausam.imd.gov.in/api
IMD_API_KEY=

BHOONIDHI_ENABLED=false
BHOONIDHI_BASE_URL=https://bhoonidhi.nrsc.gov.in/api
BHOONIDHI_API_KEY=

BHASHINI_ENABLED=false
BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in/services/inference
BHASHINI_API_KEY=

OPEN_METEO_ENABLED=true
MAP_TILES_URL=https://demotiles.maplibre.org/style.json

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Legacy feature compatibility flags
FEATURE_INCOIS=false
FEATURE_IMD=false
FEATURE_BHOONIDHI=false
FEATURE_BHASHINI=false
FEATURE_NAVIC=false
FEATURE_MOSDAC=false
